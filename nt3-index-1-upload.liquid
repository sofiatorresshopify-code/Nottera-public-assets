/* ============ MOBILE: consistent rhythm & alignment ============
   On phones the viewport is tall and narrow, so vh-based min-heights leave
   large empty gaps around short content. Let the sections size to their
   content instead and use one shared horizontal gutter so every block —
   text, photos, cards, bands — lines up on the same edges. */
@media (max-width: 720px) {
  .scene { min-height: auto; padding: 5vh 6vw; }
