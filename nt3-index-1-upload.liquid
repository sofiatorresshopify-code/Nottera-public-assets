<script>
/* Scroll-driven atmosphere — a continuous journey through space into morning.

   The starfield is procedural: layered stars with parallax depths that
   stream past as you scroll (you travel down through the universe) plus a
   constant slow drift so the sky is never static. Stars twinkle; a handful
   of bright stars carry soft diffraction spikes. Behind them a nebula and a
   sunrise (earth-sun.jpg) parallax slowly and cross-fade into daylight. */

const prefersReducedMotion =
  window.matchMedia('(prefers-reduced-motion: reduce)').matches;

const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));

function smoothstep(a, b, x) {
  const t = clamp((x - a) / (b - a));
  return t * t * (3 - 2 * t);
}

/* Fine realistic star: a crisp bright core with a tight, quickly-falling
   halo — reads as a clean pinpoint even at sub-pixel sizes. */
function makeGlowSprite(size, warm) {
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const g = c.getContext('2d');
  const r = size / 2;
  const grad = g.createRadialGradient(r, r, 0, r, r, r);
  const core = warm ? '255, 247, 234' : '238, 243, 253';
  grad.addColorStop(0, `rgba(${core}, 1)`);
  grad.addColorStop(0.09, `rgba(${core}, 0.82)`);
  grad.addColorStop(0.24, `rgba(${warm ? '224, 196, 158' : '176, 196, 232'}, 0.14)`);
  grad.addColorStop(0.55, 'rgba(150, 175, 225, 0.03)');
  grad.addColorStop(1, 'rgba(150, 175, 225, 0)');
  g.fillStyle = grad;
  g.fillRect(0, 0, size, size);
  return c;
}

/* A slightly brighter star with very fine, faint diffraction spikes —
   used sparingly so the field stays realistic, never showy. */
function makeSparkleSprite(size, warm) {
  const c = makeGlowSprite(size, warm);
  const g = c.getContext('2d');
  const r = size / 2;
  const core = warm ? '255, 247, 234' : '240, 245, 255';
  g.globalCompositeOperation = 'lighter';
  for (const vertical of [true, false]) {
    const grad = vertical
      ? g.createLinearGradient(r, 0, r, size)
      : g.createLinearGradient(0, r, size, r);
    grad.addColorStop(0, `rgba(${core}, 0)`);
    grad.addColorStop(0.5, `rgba(${core}, 0.4)`);
    grad.addColorStop(1, `rgba(${core}, 0)`);
    g.fillStyle = grad;
    if (vertical) g.fillRect(r - size * 0.006, size * 0.16, size * 0.012, size * 0.68);
    else g.fillRect(size * 0.16, r - size * 0.006, size * 0.68, size * 0.012);
  }
  return c;
}
/* Starfield, GPU edition.
   Every star is a GL point whose glow is computed analytically in the fragment
   shader, so it stays a round, crisp star at any device pixel ratio instead of
   an upscaled bitmap. Parallax, drift and twinkle all run in the vertex shader,
   so a frame costs one drawArrays call — no per-star CPU work, no full-screen
   composites, and nothing to stutter on. Falls back to the canvas2d version. */
function initAtmosphere() {
  const canvas = document.getElementById('stars');
  if (!canvas) return;

  let gl = null;
  try {
    const opts = { alpha: true, premultipliedAlpha: true, antialias: false,
                   depth: false, stencil: false, powerPreference: 'low-power' };
    gl = canvas.getContext('webgl', opts) || canvas.getContext('experimental-webgl', opts);
  } catch (e) { gl = null; }
  if (!gl) { initAtmosphere2D(); return; }

  const root = document.documentElement;
  const nav = document.getElementById('nav');

  /* highp in the vertex stage matters: u_t grows without bound and mediump
     would quantise it into visible jitter after a minute or two. */
  const VS = `
    precision highp float;
    attribute vec2 a_pos;    // x, y in 0..1 world space
    attribute vec4 a_attr;   // point size (css px), magnitude, parallax, warm
    attribute vec2 a_tw;     // twinkle phase, twinkle speed (rad/s)
    uniform vec2  u_res;
    uniform float u_scroll;  // smoothed scroll, device px
    uniform float u_t;       // seconds, wrapped
    uniform float u_dpr;
    uniform float u_spike;   // magnitude above which a star gets a cross
    varying float v_alpha;
    varying float v_warm;
    varying float v_cross;
    void main() {
      float par = a_attr.z;
      float travel = (u_scroll * par) + (u_t * 7.5 * par * u_dpr);
      float y = fract(a_pos.y - travel / u_res.y);
      gl_Position = vec4(a_pos.x * 2.0 - 1.0, 1.0 - y * 2.0, 0.0, 1.0);

      float w1 = 0.5 + 0.5 * sin(a_tw.x + u_t * a_tw.y);
      float w2 = 0.5 + 0.5 * sin(a_tw.x * 2.3 + u_t * a_tw.y * 0.61);
      float amp = 0.18 + (1.0 - a_attr.y) * 0.34;   // faint stars scintillate more
      float tw  = 1.0 - amp + amp * (w1 * 0.62 + w2 * 0.38);

      v_alpha = a_attr.y * tw;
      v_warm  = a_attr.w;
      v_cross = step(u_spike, a_attr.y);
      gl_PointSize = a_attr.x * u_dpr;
    }
  `;

  const FS = `
    precision mediump float;
    varying float v_alpha;
    varying float v_warm;
    varying float v_cross;
    void main() {
      vec2 c = gl_PointCoord - 0.5;
      // Falloff expressed in squared distance: no sqrt, and the powers below
      // are plain multiplies rather than pow() calls.
      float t = max(0.0, 1.0 - dot(c, c) * 4.0);
      float t2 = t * t;            // soft halo
      float t4 = t2 * t2;
      float core = t4 * t4;        // tight bright pinpoint
      float cross = 0.0;
      if (v_cross > 0.5) {
        float hx = max(0.0, 1.0 - abs(c.y) * 30.0) * max(0.0, 1.0 - abs(c.x) * 2.5);
        float vy = max(0.0, 1.0 - abs(c.x) * 30.0) * max(0.0, 1.0 - abs(c.y) * 2.5);
        cross = (hx + vy) * 0.28;
      }
      float i = t2 * 0.18 + core + cross;
      if (i <= 0.002) discard;
      vec3 col = mix(vec3(0.86, 0.90, 1.00), vec3(1.00, 0.92, 0.80), v_warm);
      float a = clamp(i * v_alpha, 0.0, 1.0);
      gl_FragColor = vec4(col * a, a);   // premultiplied, blended additively
    }
  `;

  function compile(type, src) {
    const sh = gl.createShader(type);
    gl.shaderSource(sh, src);
    gl.compileShader(sh);
    if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) { gl.deleteShader(sh); return null; }
    return sh;
  }
  const vs = compile(gl.VERTEX_SHADER, VS);
  const fs = compile(gl.FRAGMENT_SHADER, FS);
  if (!vs || !fs) { initAtmosphere2D(); return; }
  const prog = gl.createProgram();
  gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { initAtmosphere2D(); return; }
  gl.useProgram(prog);

  const A_POS = gl.getAttribLocation(prog, 'a_pos');
  const A_ATTR = gl.getAttribLocation(prog, 'a_attr');
  const A_TW = gl.getAttribLocation(prog, 'a_tw');
  const U_RES = gl.getUniformLocation(prog, 'u_res');
  const U_SCROLL = gl.getUniformLocation(prog, 'u_scroll');
  const U_T = gl.getUniformLocation(prog, 'u_t');
  const U_DPR = gl.getUniformLocation(prog, 'u_dpr');
  const U_SPIKE = gl.getUniformLocation(prog, 'u_spike');

  const buf = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, buf);
  const STRIDE = 8 * 4;
  gl.enableVertexAttribArray(A_POS);
  gl.vertexAttribPointer(A_POS, 2, gl.FLOAT, false, STRIDE, 0);
  gl.enableVertexAttribArray(A_ATTR);
  gl.vertexAttribPointer(A_ATTR, 4, gl.FLOAT, false, STRIDE, 8);
  gl.enableVertexAttribArray(A_TW);
  gl.vertexAttribPointer(A_TW, 2, gl.FLOAT, false, STRIDE, 24);

  gl.disable(gl.DEPTH_TEST);
  gl.enable(gl.BLEND);
  gl.blendFunc(gl.ONE, gl.ONE);           // additive: overlapping glows sum
  gl.clearColor(0, 0, 0, 0);
  gl.uniform1f(U_SPIKE, 0.88);

  let dpr = 1, count = 0;

  function build() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);   // native on retina, no upscale
    canvas.width = Math.round(innerWidth * dpr);
    canvas.height = Math.round(innerHeight * dpr);
    gl.viewport(0, 0, canvas.width, canvas.height);
    gl.uniform2f(U_RES, canvas.width, canvas.height);
    gl.uniform1f(U_DPR, dpr);

    count = Math.min(1900, Math.floor((innerWidth * innerHeight) / 780));
    const data = new Float32Array(count * 8);
    for (let i = 0; i < count; i++) {
      const o = i * 8;
      const depth = Math.random();
      const big = Math.pow(Math.random(), 4.2);        // a rare few burn bright
      data[o]     = Math.random();
      data[o + 1] = Math.random();
      data[o + 2] = 2.0 + big * 5.0 + depth * 0.8;     // point size, css px
      data[o + 3] = Math.min(1, 0.10 + big * 0.85 + depth * 0.10);
      data[o + 4] = 0.10 + depth * 0.52;               // parallax: near travels faster
      data[o + 5] = Math.random() < 0.14 ? 1 : 0;      // warm tint
      data[o + 6] = Math.random() * Math.PI * 2;
      data[o + 7] = 0.22 + Math.random() * 0.55;
    }
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
  }

  let scrollTarget = window.scrollY || 0;
  let scrollSmooth = scrollTarget;

  function draw(tSeconds) {
    gl.clear(gl.COLOR_BUFFER_BIT);
    gl.uniform1f(U_T, tSeconds);
    gl.uniform1f(U_SCROLL, scrollSmooth * dpr);
    gl.drawArrays(gl.POINTS, 0, count);
  }

  /* Scroll is sampled inside the render loop, not from scroll events. Driving
     parallax off events gives it a second, independent cadence from drawing;
     during momentum scrolling the two drift apart and the field advances in
     visible steps. Sampling per frame locks motion to the frame clock. */
  function syncChrome() {
    if (nav) nav.classList.toggle('scrolled', (window.scrollY || 0) > 40);
  }

  build();
  // Stay in the calm night the whole way — set once, not on every scroll.
  root.style.setProperty('--daylight', '0');
  syncChrome();

  let resizeTimer = null;
  addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(build, 150);
  }, { passive: true });

  let ticking = false;
  addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(() => { syncChrome(); ticking = false; }); ticking = true; }
  }, { passive: true });

  canvas.addEventListener('webglcontextlost', (e) => { e.preventDefault(); }, false);
  canvas.addEventListener('webglcontextrestored', () => { try { build(); } catch (e) {} }, false);

  if (prefersReducedMotion) {
    scrollSmooth = window.scrollY || 0;
    draw(0);
    addEventListener('scroll', () => { scrollSmooth = window.scrollY || 0; draw(0); }, { passive: true });
  } else {
    let last = performance.now();
    const loop = (now) => {
      const dt = Math.min(now - last, 60);
      last = now;
      scrollTarget = window.scrollY || 0;               // sampled on the frame clock
      // Frame-rate independent easing. Short time constant: close enough to
      // track the scroll 1:1 so it never feels rubber-banded, long enough to
      // absorb the jitter of a dropped frame.
      scrollSmooth += (scrollTarget - scrollSmooth) * (1 - Math.exp(-dt / 45));
      draw((now / 1000) % 3600);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
}

function initAtmosphere2D() {
  const canvas = document.getElementById('stars');
  const ctx = canvas.getContext('2d');
  const root = document.documentElement;
  const nav = document.getElementById('nav');
  const clouds = document.getElementById('clouds');

  const SPRITE = 64;
  const sprites = {
    cool: makeGlowSprite(SPRITE, false),
    warm: makeGlowSprite(SPRITE, true),
    sparkleCool: makeSparkleSprite(128, false),
    sparkleWarm: makeSparkleSprite(128, true)
  };

  /* The faint majority of stars never visibly twinkle, so they are baked once
     into a few static parallax layers and blitted with 2 drawImage calls each.
     Only the brighter minority is animated per-star. This takes the per-frame
     draw count from ~1500 to ~200 and holds 60fps on tablets. */
  let layers = [];        // { canvas, par }
  let twinklers = [];     // individually animated stars
  let sparkles = [];
  let worldH = 1, W = 1, H = 1, dpr = 1;

  let scrollTarget = window.scrollY || 0;
  let scrollSmooth = scrollTarget;

  const LAYER_PAR = [0.13, 0.29, 0.52];
  const MAX_PIXELS = 3.5e6;   // bounds layer memory on large displays

  function buildStars() {
    // Cap resolution: these are soft glow points, not type — extra pixels buy
    // nothing visually and cost a lot of fill rate.
    const raw = Math.min(window.devicePixelRatio || 1, 1.5);
    const fit = Math.sqrt(MAX_PIXELS / Math.max(1, innerWidth * innerHeight * raw * raw));
    dpr = raw * Math.min(1, fit);

    W = canvas.width = Math.round(innerWidth * dpr);
    H = canvas.height = Math.round(innerHeight * dpr);
    worldH = H;

    const total = Math.min(1700, Math.floor((innerWidth * innerHeight) / 850));
    const perLayer = Math.floor((total * 0.86) / LAYER_PAR.length);

    layers = LAYER_PAR.map((par, i) => {
      const lc = document.createElement('canvas');
      lc.width = W; lc.height = H;
      const lg = lc.getContext('2d');
      lg.globalCompositeOperation = 'lighter';
      for (let n = 0; n < perLayer; n++) {
        const big = Math.pow(Math.random(), 4);
        const size = (0.26 + big * 2.1 + i * 0.24) * dpr;
        lg.globalAlpha = clamp(0.07 + big * 0.40 + i * 0.05 + Math.random() * 0.10, 0, 0.7);
        const x = Math.random() * W, y = Math.random() * H;
        const sprite = Math.random() < 0.14 ? sprites.warm : sprites.cool;
        lg.drawImage(sprite, x - size, y - size, size * 2, size * 2);
        // repeat across the vertical seam so the tiled layer wraps invisibly
        if (y < size) lg.drawImage(sprite, x - size, y + H - size, size * 2, size * 2);
        else if (y > H - size) lg.drawImage(sprite, x - size, y - H - size, size * 2, size * 2);
      }
      return { canvas: lc, par };
    });

    // The bright few that actually scintillate.
    const tCount = Math.max(0, total - perLayer * LAYER_PAR.length);
    twinklers = Array.from({ length: tCount }, () => {
      const depth = Math.random();
      const big = Math.pow(Math.random(), 3);
      const base = clamp(0.20 + big * 0.60 + depth * 0.14, 0, 0.95);
      return {
        x: Math.random() * W,
        y: Math.random() * worldH,
        size: (0.5 + big * 3.2 + depth * 0.5) * dpr,
        base,
        // fainter stars scintillate more, bright ones sit steadier
        amp: 0.20 + (1 - base) * 0.34,
        warm: Math.random() < 0.14,
        phase: Math.random() * Math.PI * 2,
        w1: 0.00022 + Math.random() * 0.00055,
        par: 0.12 + depth * 0.5
      };
    });

    const sparkleCount = Math.min(9, Math.floor(total / 170));
    sparkles = Array.from({ length: sparkleCount }, () => ({
      x: Math.random() * W,
      y: Math.random() * worldH,
      size: (2.6 + Math.random() * 3) * dpr,
      base: 0.4 + Math.random() * 0.3,
      warm: Math.random() < 0.3,
      phase: Math.random() * Math.PI * 2,
      w1: 0.00018 + Math.random() * 0.00035,
      par: 0.1 + Math.random() * 0.22
    }));
  }

  function draw(t) {
    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'lighter';

    const drift = t * 0.0075;             // constant, gentle upward stream
    const base = scrollSmooth * dpr;

    // static depth layers — 2 blits each, wrapping seamlessly
    ctx.globalAlpha = 1;
    for (const L of layers) {
      let off = (base * L.par + drift * L.par) % worldH;
      if (off < 0) off += worldH;
      ctx.drawImage(L.canvas, 0, -off);
      ctx.drawImage(L.canvas, 0, worldH - off);
    }

    for (const s of twinklers) {
      let y = (s.y - (base * s.par + drift * s.par)) % worldH;
      if (y < 0) y += worldH;
      let a = s.base;
      if (!prefersReducedMotion) {
        // two detuned sines read as organic scintillation, not a metronome
        const w = 0.5 + 0.5 * Math.sin(s.phase + t * s.w1);
        const w2 = 0.5 + 0.5 * Math.sin(s.phase * 2.3 + t * s.w1 * 0.61);
        a = s.base * (1 - s.amp + s.amp * (w * 0.62 + w2 * 0.38));
      }
      ctx.globalAlpha = a;
      ctx.drawImage(s.warm ? sprites.warm : sprites.cool,
                    s.x - s.size, y - s.size, s.size * 2, s.size * 2);
    }

    for (const s of sparkles) {
      let y = (s.y - (base * s.par + drift * s.par)) % worldH;
      if (y < 0) y += worldH;
      let pulse = s.base, size = s.size;
      if (!prefersReducedMotion) {
        pulse = s.base * (0.6 + 0.4 * (0.5 + 0.5 * Math.sin(s.phase + t * s.w1)));
        size = s.size * (1 + 0.12 * Math.sin(s.phase * 1.7 + t * s.w1 * 0.8));
      }
      ctx.globalAlpha = pulse;
      ctx.drawImage(s.warm ? sprites.sparkleWarm : sprites.sparkleCool,
                    s.x - size, y - size, size * 2, size * 2);
    }

    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = 'source-over';
  }

  function readScroll() {
    scrollTarget = window.scrollY || 0;
    // Stay in the calm night the whole way — no daybreak, stars throughout.
    root.style.setProperty('--daylight', '0');
    nav.classList.toggle('scrolled', scrollTarget > 40);
  }

  buildStars();
  readScroll();
  void clouds;

  let resizeTimer = null;
  addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(buildStars, 150);
  }, { passive: true });

  let ticking = false;
  addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => { readScroll(); ticking = false; });
      ticking = true;
    }
  }, { passive: true });

  if (prefersReducedMotion) {
    scrollSmooth = scrollTarget;
    draw(0);
    addEventListener('scroll', () => { scrollSmooth = window.scrollY || 0; draw(0); }, { passive: true });
  } else {
    let last = performance.now();
    const loop = (t) => {
      // frame-rate independent easing: parallax glides instead of snapping
      const dt = Math.min(t - last, 60);
      last = t;
      scrollSmooth += (scrollTarget - scrollSmooth) * (1 - Math.exp(-dt / 90));
      draw(t);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
}

/* Progressive reveal: elements fade upward once, as they enter view. */
function initReveal() {
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
        io.unobserve(entry.target);
      }
    }
  }, { threshold: 0.18, rootMargin: '0px 0px -6% 0px' });

  document.querySelectorAll('.reveal, .reveal-slow').forEach((el) => io.observe(el));
}

/* Gentle parallax on staged imagery — max ~5% drift, almost invisible. */
function initParallax() {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const els = Array.from(document.querySelectorAll('.parallax'));
  if (!els.length) return;
  let ticking = false;

  function update() {
    for (const el of els) {
      const rect = el.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > innerHeight) continue;
      const centerOffset = (rect.top + rect.height / 2 - innerHeight / 2) / innerHeight;
      const depth = parseFloat(el.dataset.depth || '0.05');
      el.style.transform =
        'translateY(' + (-centerOffset * depth * 100).toFixed(2) + 'px)';
    }
  }

  addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => { update(); ticking = false; });
      ticking = true;
    }
  }, { passive: true });

  update();
}

/* FAQ accordion: soft height animation on open/close, one open at a time. */

const DURATION = 600;
const EASE = 'cubic-bezier(0.4, 0.0, 0.2, 1)';
function initFaq() {
  const container = document.getElementById('faq');
  if (!container) return;
  const items = Array.from(container.querySelectorAll('details'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const item of items) {
    const summary = item.querySelector('summary');
    const body = item.querySelector('.faq-body');

    summary.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = item.open;

      for (const other of items) {
        if (other !== item && other.open) close(other, other.querySelector('.faq-body'));
      }
      isOpen ? close(item, body) : open(item, body);
    });
  }

  function open(item, body) {
    item.open = true;
    if (reduced) return;
    const h = body.scrollHeight;
