 closeDrawer() {
    overlay.classList.remove('open');
    drawer.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(() => { overlay.hidden = true; }, 650);
  }
  toggle.addEventListener('click', openDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('open')) closeDrawer();
  });

  itemsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;
    const item = items.find((i) => i.key === btn.dataset.key);
    if (!item) return;
    if (btn.dataset.action === 'inc') item.qty += 1;
    if (btn.dataset.action === 'dec') item.qty -= 1;
    items = items.filter((i) => i.qty > 0);
    save();
    render();
  });

  const VARIANT_IDS = {
    pillowcrescent: 56851707429204,
    pilloweclipse: 56851707461972,
    casecrescent: { moonlight: 56850855461204, nebula: 56850855493972, polaris: 56850855526740, aurora: 56850855657812, venus: 56850855723348 },
    caseeclipse: { moonlight: 56850855559508, nebula: 56850855592276, polaris: 56850855625044, aurora: 56850855690580, venus: 56850855756116 }
  };
  function resolveVariantId(item) {
    const v = VARIANT_IDS[item.id];
    if (!v) return null;
    if (typeof v === 'number') return v;
    const text = (item.variant || '').toLowerCase();
    const colors = ['moonlight', 'nebula', 'polaris', 'aurora', 'venus'];
    const found = colors.find((c) => text.indexOf(c) !== -1);
    return v[found || 'moonlight'];
  }
  async function goToCheckout(extraQuery) {
    const parts = items
      .map((i) => { const vid = resolveVariantId(i); return vid ? { id: vid, quantity: i.qty } : null; })
      .filter(Boolean);
    if (!parts.length) return;
    const bundleCode = items.some((i) => i.dealNote && i.dealNote.includes('Nottera Eos Set'))
      ? 'EOS15'
      : items.some((i) => i.dealNote && i.dealNote.includes('Nottera Nocturne Set'))
      ? 'NOCTURNE20'
      : items.some((i) => i.dealNote && i.dealNote.includes('Volume · 15% off'))
      ? 'VOL15'
      : items.some((i) => i.dealNote && i.dealNote.includes('Volume · 10% off'))
      ? 'VOL10'
      : null;
    try {
      await fetch('/cart/clear.js', { method: 'POST', credentials: 'same-origin' });
      const addRes = await fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: parts })
      });
      if (!addRes.ok) {
        const err = await addRes.json().catch(() => ({}));
        console.error('Nottera cart add failed:', addRes.status, err);
        showToast((err && err.description) || 'Something went wrong adding your items — please try again.');
        return;
      }
    } catch (e) {
      console.error('Nottera cart add failed:', e);
      showToast('Something went wrong adding your items — please try again.');
      return;
    }
    const qs = [];
    if (bundleCode) qs.push('discount=' + bundleCode);
    if (extraQuery) qs.push(extraQuery);
    window.location.href = '/checkout' + (qs.length ? '?' + qs.join('&') : '');
  }
  function orderSnapshot() {
    return items.map((i) => ({ name: PRODUCTS[i.id].name, variant: i.variant || '', qty: i.qty, price: priceOf(i) }));
  }
  drawer.querySelector('.cart-checkout').addEventListener('click', () => {
    if (!items.length) return;
    const total = items.reduce((n, i) => n + i.qty * priceOf(i), 0);
    window.NotteraAccount?.creditPurchasePoints(total);
    window.NotteraAccount?.recordOrder(orderSnapshot(), total);
    goToCheckout();
  });
  drawer.querySelector('.cart-paypal').addEventListener('click', () => {
    if (!items.length) return;
    const total = items.reduce((n, i) => n + i.qty * priceOf(i), 0);
    window.NotteraAccount?.creditPurchasePoints(total);
    window.NotteraAccount?.recordOrder(orderSnapshot(), total);
    goToCheckout('payment=paypal');
  });
  drawer.querySelector('.cart-applepay').addEventListener('click', () => {
    if (!items.length) return;
    const total = items.reduce((n, i) => n + i.qty * priceOf(i), 0);
    window.NotteraAccount?.creditPurchasePoints(total);
    window.NotteraAccount?.recordOrder(orderSnapshot(), total);
    goToCheckout('payment=apple_pay');
  });

  function render() {
    const count = items.reduce((n, i) => n + i.qty, 0);
    const total = items.reduce((n, i) => n + i.qty * priceOf(i), 0);

    countEl.hidden = count === 0;
    countEl.textContent = count;
    emptyEl.hidden = count > 0;
    footEl.hidden = count === 0;
    totalEl.textContent = money(total);
    if (financeEl) financeEl.textContent = 'or 4 interest-free payments of ' + money(total / 4) + ' with Shop Pay';
    if (pointsEl) pointsEl.textContent = count > 0 ? `Check out now and earn ${Math.round(total * 2)} Nottera Rewards points` : '';

    itemsEl.innerHTML = items.map((i) => {
      if (i.id === 'guide') {
        return `
      <li class="cart-item cart-item-gift">
        <div class="cart-item-info">
          <h5>${PRODUCTS[i.id].name}</h5>
          <p class="cart-line-note gold">Free gift · unlocked on this order</p>
        </div>
        <span class="cart-item-price"><span class="cart-item-free">FREE</span></span>
      </li>`;
      }
      const hasDeal = typeof i.dealPrice === 'number';
      const active = dealActive(i);
      const dealNote = hasDeal
        ? (active
            ? `<p class="cart-line-note gold">${i.dealNote || ('Bundle price · $' + (PRODUCTS[i.id].price - i.dealPrice).toFixed(0) + ' off')}</p>`
            : (i.dealRequires
                ? `<p class="cart-line-note warn">Add ${(Array.isArray(i.dealRequires) ? i.dealRequires : [i.dealRequires]).map((rid) => PRODUCTS[rid].name).join(' + ')} to unlock $${(PRODUCTS[i.id].price - i.dealPrice).toFixed(0)} off</p>`
                : `<p class="cart-line-note warn">Add ${i.dealMinQty - i.qty} more to unlock $${(PRODUCTS[i.id].price - i.dealPrice).toFixed(0)} off each</p>`))
        : '';
      const note = (i.variant ? `<p>${i.variant}</p>` : '') + dealNote;
      return `
      <li class="cart-item">
        <div class="cart-item-info">
          <h5>${PRODUCTS[i.id].name}</h5>
          ${note}
        </div>
        <div class="cart-item-qty">
          <button data-action="dec" data-key="${i.key}" aria-label="Decrease quantity">−</button>
          <span>${i.qty}</span>
          <button data-action="inc" data-key="${i.key}" aria-label="Increase quantity">+</button>
        </div>
        <span class="cart-item-price">
          ${active ? `<span class="cart-item-was">${money(i.qty * PRODUCTS[i.id].price)}</span>` : ''}
          ${money(i.qty * priceOf(i))}
        </span>
      </li>`;
    }).join('');

    renderUpsell();
  }

  function upsellCard(offer) {
    const p = PRODUCTS[offer.id];
    const isCase = /^case(crescent|eclipse)$/.test(offer.id);
    const isPillow = /^pillow(crescent|eclipse)$/.test(offer.id);
    const img = isCase ? ((window.NOTTERA_CASE_HERO || {}).moonlight || p.img)
      : isPillow ? ((window.NOTTERA_PILLOW_HERO || {})[offer.id.replace('pillow', '')] || p.img)
      : p.img;
    return `
      <p class="cart-upsell-head">${offer.tag}</p>
      <div class="cart-upsell-card">
        <img src="${img}" alt="" loading="lazy">
        <div class="cart-upsell-info">
          <h6>${p.name}</h6>
          <p>${offer.line}</p>
          <span class="cart-upsell-price">${money(p.price)}</span>
        </div>
        <button class="cart-upsell-add" type="button" data-add="${offer.id}" data-variant="${offer.variant}" aria-label="Add ${p.name}">Add +</button>
      </div>`;
  }
  function pickUpsell() {
    const pillowItem = items.find((i) => i.id === 'pillowcrescent' || i.id === 'pilloweclipse');
    const caseItem = items.find((i) => /^case(crescent|eclipse)$/.test(i.id));
    const sizeOf = (i) => (/eclipse/.test(i.id) ? 'eclipse' : 'crescent');
    const sizeName = (k) => (k === 'eclipse' ? 'Eclipse' : 'Crescent');

    if (pillowItem && !caseItem) {
      const size = sizeOf(pillowItem), id = 'case' + size;
      return { id, variant: `Ice-Silk · Moonlight · ${sizeName(size)}`, tag: 'Complete your set',
        line: `Add an ice-silk pillowcase in ${sizeName(size)} to match your pillow.` };
    }
    if (caseItem && !pillowItem) {
      const size = sizeOf(caseItem), id = 'pillow' + size;
      return { id, variant: `Nottera Pillow · ${sizeName(size)}`, tag: 'Complete your set',
        line: `Add the Nottera Pillow in ${sizeName(size)} to match your pillowcase.` };
    }
    return null;
  }
  function renderUpsell() {
    if (!upsellEl) return;
    if (items.length === 0) { upsellEl.hidden = true; upsellEl.innerHTML = ''; return; }
    const offer = pickUpsell();
    if (!offer) { upsellEl.hidden = true; upsellEl.innerHTML = ''; return; }
    upsellEl.hidden = false;
    upsellEl.innerHTML = upsellCard(offer);
  }
  upsellEl?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-add]');
    if (!btn) return;
    addItem(btn.dataset.add, btn.dataset.variant || '', 1, null);
    showToast(PRODUCTS[btn.dataset.add].name + ' added to your night');
  });

  function showToast(message) {
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 3200);
  }

  function load() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed)
        ? parsed.filter((i) => PRODUCTS[i.id] && i.qty > 0)
        : [];
    } catch {
      return [];
    }
  }
  function save() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(items)); } catch {}
  }

  window.NotteraCart = {
    add(id, variant = '', qty = 1, deal = null) {
      addItem(id, variant, qty, deal);
      const p = PRODUCTS[id];
      if (p && id !== 'guide') showToast(p.name + (variant ? ' · ' + variant : '') + ' added to your night');
    },
    remove(id) {
      const idx = items.findIndex((i) => i.id === id);
      if (idx > -1) { items.splice(idx, 1); save(); render(); }
    },
    getTotal() { return items.reduce((n, i) => (i.id === 'guide' ? n : n + i.qty * priceOf(i)), 0); },
    open: openDrawer,
    catalog: PRODUCTS
  };

  render();
}
