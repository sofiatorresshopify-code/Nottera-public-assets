/* Scroll-driven scene behaviours:
   - Discover: one fixed frame whose image and caption change per step.
   - Materials: the macro photograph zooms slowly while scrolling.
   - Goodnight: newsletter submit feedback. */
function initScenes() {
  initDiscover();
  initMacroZoom();
  initReviews();
  initNewsletter();
}

const clampR = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));

function initReviews() {
  const summaryEl = document.getElementById('ratingSummary');
  const cardsEl = document.getElementById('reviewsCards');
  if (!summaryEl && !cardsEl) return;

  const PENDING_KEY = 'notterra-pending-reviews';
  const SEED = {};
  const REVIEWS = [];

  function savePendingReview(r) {
    try {
      const raw = localStorage.getItem(PENDING_KEY);
      const list = raw ? JSON.parse(raw) : [];
      list.push(r);
      localStorage.setItem(PENDING_KEY, JSON.stringify(list));
    } catch {}
  }

  function starString(n) {
    return `<span class="social-stars-fill" style="position:static;overflow:visible;display:inline">${'★'.repeat(n)}</span>${'☆'.repeat(5 - n)}`;
  }

  function renderSummary() {
    if (!summaryEl) return;
    const total = Object.values(SEED).reduce((a, b) => a + b, 0);
    if (!total) {
      summaryEl.innerHTML = `
        <div class="rating-summary-main rating-summary-empty">
          <span class="rating-empty-text">We're brand new — no reviews yet. Your 60-night trial is the real guarantee.</span>
        </div>
        <button class="btn write-review-btn" type="button" id="writeReviewBtn">Write a Review</button>`;
      document.getElementById('writeReviewBtn').addEventListener('click', openReviewModal);
      return;
    }
    const weighted = Object.entries(SEED).reduce((a, [s, c]) => a + Number(s) * c, 0);
    const avg = (weighted / total).toFixed(1);
    const bars = [5, 4, 3, 2, 1].map((n) => {
      const count = SEED[n];
      const pct = Math.round((count / total) * 100);
      return `<div class="rating-bar-row">
        <span class="rating-bar-label">${n} star</span>
        <span class="rating-bar-track"><span class="rating-bar-fill" style="width:${pct}%"></span></span>
        <span class="rating-bar-count">${count}</span>
      </div>`;
    }).join('');
    summaryEl.innerHTML = `
      <div class="rating-summary-main">
        <span class="rating-big">${avg}</span>
        <span class="social-stars">${starString(Math.round(avg))}</span>
        <span class="rating-count">${total} reviews</span>
      </div>
      <div class="rating-bars">${bars}</div>
      <button class="btn write-review-btn" type="button" id="writeReviewBtn">Write a Review</button>`;
    document.getElementById('writeReviewBtn').addEventListener('click', openReviewModal);
  }

  function renderCards() {
    if (!cardsEl) return;
    cardsEl.innerHTML = REVIEWS.map((r) => `
      <div class="review-card">
        <span class="social-stars">${starString(r.stars)}</span>
        <p class="review-card-text">&ldquo;${r.text}&rdquo;</p>
        <p class="review-card-person">${r.name} &middot; ${r.place}</p>
      </div>`).join('');
  }

  const modal = document.createElement('div');
  modal.className = 'popup-overlay';
  modal.innerHTML = `
    <div class="popup review-modal" role="dialog" aria-modal="true" aria-labelledby="reviewModalTitle">
      <button class="popup-close" type="button" aria-label="Close">&times;</button>
      <p class="popup-kicker">Share your night</p>
      <h3 id="reviewModalTitle">Write a review</h3>
      <div class="review-star-picker" role="radiogroup" aria-label="Your rating">
        ${[1, 2, 3, 4, 5].map((n) => `<button type="button" data-star="${n}" aria-label="${n} star${n > 1 ? 's' : ''}">★</button>`).join('')}
      </div>
      <form class="popup-form review-form" novalidate>
        <input type="text" class="popup-input" name="name" placeholder="Your name" maxlength="40" required>
        <textarea class="popup-input review-textarea" name="text" placeholder="Tell us about your nights with Nottera..." maxlength="400" rows="4" required></textarea>
        <button type="submit" class="btn btn-primary popup-submit">Submit review</button>
      </form>
      <p class="popup-success review-success" hidden>Thank you — your review has been submitted and will appear once our team reviews it.</p>
    </div>`;
  document.body.appendChild(modal);

  const picker = modal.querySelector('.review-star-picker');
  const form = modal.querySelector('.review-form');
  const successEl = modal.querySelector('.review-success');
  let selectedStars = 0;

  picker.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
    selectedStars = Number(b.dataset.star);
    picker.querySelectorAll('button').forEach((x) => x.classList.toggle('on', Number(x.dataset.star) <= selectedStars));
  }));

  function resetModal() {
    form.reset();
    form.hidden = false;
    form.classList.remove('invalid');
    picker.hidden = false;
    picker.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
    selectedStars = 0;
    successEl.hidden = true;
  }
  function openReviewModal() {
    resetModal();
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeReviewModal() {
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }
  modal.querySelector('.popup-close').addEventListener('click', closeReviewModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeReviewModal(); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('open')) closeReviewModal(); });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = form.name.value.trim();
    const text = form.text.value.trim();
    if (!name || !text || !selectedStars) {
      form.classList.add('invalid');
      form.name.classList.toggle('error', !name);
      form.text.classList.toggle('error', !text);
      return;
    }
    savePendingReview({ name, text, stars: selectedStars, ts: Date.now() });

    form.hidden = true;
    picker.hidden = true;
    successEl.hidden = false;
    setTimeout(closeReviewModal, 2200);
  });
  form.name.addEventListener('input', () => form.name.classList.remove('error'));
  form.text.addEventListener('input', () => form.text.classList.remove('error'));

  renderSummary();
  renderCards();
}

function initDiscover() {
  const track = document.getElementById('discoverTrack');
  if (!track) return;
  const images = track.querySelectorAll('[data-step-img]');
  const captions = track.querySelectorAll('[data-step-caption]');

  function activate(step) {
    images.forEach((el) => el.classList.toggle('active', el.dataset.stepImg === step));
    captions.forEach((el) => el.classList.toggle('active', el.dataset.stepCaption === step));
  }

  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) activate(entry.target.dataset.step);
    }
  }, { rootMargin: '-45% 0px -45% 0px' });

  track.querySelectorAll('.discover-step').forEach((el) => io.observe(el));
}

function initMacroZoom() {
  const img = document.getElementById('macroZoom');
  if (!img) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  let ticking = false;

  function update() {
    const rect = img.parentElement.getBoundingClientRect();
    if (rect.bottom < 0 || rect.top > innerHeight) return;
    const progress = 1 - (rect.bottom / (innerHeight + rect.height));
    const zoom = 1 + Math.min(1, Math.max(0, progress)) * 0.18;
    img.style.setProperty('--macro-zoom', zoom.toFixed(4));
    img.style.transform = `scale(${zoom.toFixed(4)})`;
  }

  addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => { update(); ticking = false; });
      ticking = true;
    }
  }, { passive: true });
  update();
}

function notteraKlaviyoSubscribe(email) {
  return fetch('https://a.klaviyo.com/client/subscriptions?company_id=YApgMC', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/vnd.api+json',
      'revision': '2024-10-15'
    },
    body: JSON.stringify({
      data: {
        type: 'subscription',
        attributes: {
          profile: {
            data: {
              type: 'profile',
              attributes: {
                email: email,
                subscriptions: {
                  email: { marketing: { consent: 'SUBSCRIBED' } }
                }
              }
            }
          }
        },
        relationships: {
          list: { data: { type: 'list', id: 'Uqidh7' } }
        }
      }
    })
  }).catch(function(err){ console.error('Klaviyo subscribe failed:', err); });
}

function initNewsletter() {
  const form = document.getElementById('newsletter');
  if (!form) return;
  const toast = document.getElementById('toast');

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = form.email.value.trim();
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    toast.textContent = valid
      ? 'Welcome to calmer nights. Check your inbox soon.'
      : 'Please enter a valid email address.';
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3200);
    if (valid) { form.reset(); notteraKlaviyoSubscribe(email); }
  });
}
