  function currentPDP(){var el=document.querySelector('.pdp2'); return el?{fab:el.dataset.fab,color:el.dataset.color}:null;}
  function selectSize(sizeK){
    var el=document.querySelector('.pdp2'); if(!el) return;
    var F=FABS[el.dataset.fab], C=COLORS[el.dataset.color], pr=F.sizes[sizeK], now=pr[0], was=pr[1];
    var sz=SIZES.filter(function(s){return s.k===sizeK;})[0];
    var q=function(id){return document.getElementById(id);};
    if(q('pdp2Now'))q('pdp2Now').textContent=money(now);
    if(q('pdp2Was'))q('pdp2Was').textContent=money(was);
    if(q('pdp2Save'))q('pdp2Save').textContent='Save '+saving(now,was)+'%';
    var add=q('pdp2Add'); if(add){add.dataset.id=F.ids[sizeK];add.dataset.variant=F.name+' · '+C.name+' · '+sz.name;}
    var shop=q('pdp2Shop'); if(shop){shop.dataset.id=F.ids[sizeK];shop.dataset.variant=F.name+' · '+C.name+' · '+sz.name;}
    Array.prototype.forEach.call(document.querySelectorAll('.pdp2-size'),function(b){b.classList.toggle('is-active',b.dataset.size===sizeK);});
    var vt=document.querySelector('.pdp2-info .voltiers'); if(vt){var w=document.createElement('div'); w.innerHTML=caseVolTiersHTML(now); vt.replaceWith(w.firstChild);}
  }
  function goSlide(i){
    var slides=document.querySelectorAll('.pdp2-slide'), thumbs=document.querySelectorAll('.pdp2-thumb');
    if(!slides.length) return; var n=slides.length; i=((i%n)+n)%n;
    Array.prototype.forEach.call(slides,function(s,k){s.classList.toggle('is-on',k===i);});
    Array.prototype.forEach.call(thumbs,function(t,k){t.classList.toggle('is-on',k===i);});
  }
  function curSlide(){var on=document.querySelector('.pdp2-slide.is-on');return on?parseInt(on.dataset.i,10):0;}

  /* ---- favourites ---- */
  function favLoad(){try{var a=JSON.parse(localStorage.getItem('notterra-favs')||'[]');return Array.isArray(a)?a:[];}catch(e){return[];}}
  function favSave(a){try{localStorage.setItem('notterra-favs',JSON.stringify(a));}catch(e){}}
  function favHas(key){return favLoad().some(function(x){return x.key===key;});}
  function favToggle(fab,color){
    var key=fab+'-'+color, a=favLoad(), i=-1;
    a.forEach(function(x,k){if(x.key===key)i=k;});
    var adding = !(i>-1);
    if(i>-1)a.splice(i,1); else a.push({key:key,fab:fab,color:color,name:COLORS[color].name,fabName:FABS[fab].name});
    favSave(a); favRefresh();
    if(adding) trackFavourite(fab,color);
  }
  /* Tells Klaviyo someone saved a product, so the "Saved for later" flow has
     something to trigger on. Only fires on add, never on remove. Klaviyo can
     only attach this to a person it already knows (a subscriber, or anyone who
     arrived from one of our emails) — anonymous browsers simply produce nothing,
     which is why this flow reaches fewer people than abandoned cart by design.
     Requires the Klaviyo onsite snippet; guarded so the site works without it. */
  function trackFavourite(fab,color){
    try{
      if(!window._learnq || typeof window._learnq.push !== 'function') return;
      var C=COLORS[color], F=FABS[fab];
      window._learnq.push(['track','Added to Favourites',{
        ProductName: C.name + ' ' + F.name + ' Pillowcase',
        Colour: C.name,
        Fabric: F.name,
        URL: 'https://www.mynottera.com/#/pc' + fab + color,
        Price: F.sizes.crescent[0]
      }]);
    }catch(e){}
  }
  function updateFav(root,fab,color){
    var btn=root.querySelector('#pdp2Fav'); if(!btn) return;
    var on=favHas(fab+'-'+color); btn.classList.toggle('on',on); btn.innerHTML=on?HEARTF:HEART;
  }
  function favRefresh(){
    var favs=favLoad();
    var cnt=document.getElementById('favCount');
    if(cnt){cnt.textContent=favs.length; cnt.hidden=favs.length===0;}
    var ft=document.getElementById('favToggle'); if(ft)ft.classList.toggle('active',favs.length>0);
    var list=document.getElementById('favList');
    if(list){
      if(!favs.length){list.innerHTML='<p class="fav-empty">No favourites yet.<br>Tap the heart on a product to save it.</p>';}
      else{list.innerHTML=favs.map(function(x){var C=COLORS[x.color];var img=(window.NOTTERA_CASE_HERO||{})[x.color];var sw=img?'<img class="fav-sw" src="'+img+'" alt="'+x.name+' pillowcase" loading="lazy">':'<span class="fav-sw'+(C.light?' is-light':'')+'" style="background:'+C.sw+'"></span>';return '<div class="fav-item">'+sw+'<div class="fav-iname"><a href="#/pc'+x.fab+x.color+'" data-fav-go>'+x.name+'</a><div class="fav-imeta">'+x.fabName+' Pillowcase</div></div><button class="fav-rm" type="button" data-fav-rm="'+x.key+'" aria-label="Remove">×</button></div>';}).join('');}
    }
    var cur=currentPDP(); if(cur){var el=document.querySelector('.pdp2'); if(el)updateFav(el,cur.fab,cur.color);}
  }

  /* ---- inject the nav heart + favourites panel ---- */
  function initFavUI(){
    var navRight=document.querySelector('.nav-right'), cart=document.querySelector('.cart-toggle');
    if(navRight&&cart&&!document.getElementById('favToggle')){
      var b=document.createElement('button'); b.className='fav-toggle'; b.id='favToggle'; b.setAttribute('aria-label','Favorites');
      b.innerHTML=HEART+'<span class="fav-count" id="favCount" hidden>0</span>';
      navRight.insertBefore(b,cart);
    }
    if(!document.getElementById('favPanel')){
      var p=document.createElement('div'); p.className='fav-panel'; p.id='favPanel';
      p.innerHTML='<div class="fav-phead"><span class="fav-ptitle">Favourites</span><button class="fav-pclose" id="favClose" aria-label="Close">×</button></div><div class="fav-plist" id="favList"></div>';
      document.body.appendChild(p);
    }
    favRefresh();
  }

