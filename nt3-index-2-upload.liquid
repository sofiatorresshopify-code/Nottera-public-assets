    nav: "Pillows", "kicker": "Pillow",
    "title": "The Nottera Pillow.",
    "body": "<div id=\"pillowRoot\"></div>"
  },
  "bed": {
    nav: "Bedding", "kicker": "Pillow Bedding",
    "title": "Pillowcases.",
    "body": "<div id=\"bedRoot\"></div>"
  },
  "bundles": {
