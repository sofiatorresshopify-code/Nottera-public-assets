function initPages() {
  /* Real content pages, not modals. The view is inserted into the document
     flow after <main>, so the site header stays fixed at the top, the footer
     stays at the bottom, and the browser scrolls the page normally. Routed at
     #/<slug> so a page can be linked, reloaded and shared, and so the browser
     Back button returns to the landing page on its own. */
  const view = document.createElement('article');
  view.className = 'page-view';
  view.hidden = true;
  view.innerHTML = `
    <div class="page-panel">
      <nav class="page-crumb" aria-label="Breadcrumb">
        <a href="#top">Nottera</a>
        <span aria-hidden="true">/</span>
        <span class="page-crumb-current" aria-current="page"></span>
      </nav>
      <p class="kicker page-kicker"></p>
      <h1 class="page-title"></h1>
      <div class="page-body"></div>
      <a class="page-back" href="#top">&larr; Back to Nottera</a>
    </div>`;

  const main = document.querySelector('main');
  const footer = document.querySelector('.footer');
  main.parentNode.insertBefore(view, main.nextSibling);

  const crumbEl = view.querySelector('.page-crumb-current');
  const kickerEl = view.querySelector('.page-kicker');
  const titleEl = view.querySelector('.page-title');
  const bodyEl = view.querySelector('.page-body');
  const baseTitle = document.title;
  let current = null;

  function slugFromHash() {
    const m = location.hash.match(/^#\/([a-z]+)$/);
    return m && PAGES[m[1]] ? m[1] : null;
  }

  function open(slug) {
    const page = PAGES[slug];
    crumbEl.textContent = page.nav || page.title;
    kickerEl.textContent = page.kicker;
    titleEl.textContent = page.title;
    bodyEl.innerHTML = page.body;
    // Swap the landing page out for this one — a page change, not an overlay.
    main.hidden = true;
    view.hidden = false;
    if (footer) footer.hidden = false;
    document.title = (page.title || page.nav) + ' — Nottera';
    current = slug;
    // Land at the top of the new page. Repeated across the next frames because
    // the landing page's scroll-driven sections settle their own offsets as
    // they unmount, which can otherwise nudge the document back down.
    const toTop = () => scrollTo({ top: 0, behavior: 'instant' });
    toTop();
    requestAnimationFrame(() => { view.classList.add('open'); toTop(); });
    setTimeout(toTop, 60);
  }

  function close() {
    view.classList.remove('open');
    view.hidden = true;
    main.hidden = false;
    document.title = baseTitle;
    current = null;
  }

  function sync() {
    const slug = slugFromHash();
    if (slug) { if (slug !== current) open(slug); else scrollTo({ top: 0, behavior: 'instant' }); }
    else if (current) close();
  }

  view.querySelector('.page-back').addEventListener('click', () => {
    // Let the hash change drive the route; sync() restores the landing page.
    setTimeout(sync, 0);
  });
  addEventListener('hashchange', sync);

  sync();
  // Safety net: some PAGES entries (journal, pillowcase color pages, etc.) are
  // registered by later inline scripts further down this document. If a user
  // navigates to one of those routes before the page has fully finished
  // loading/parsing, the check above can run before that entry exists and
  // silently fall back to the landing page. Re-validate once everything has
  // loaded so the route resolves correctly instead of getting stuck on the hero.
  addEventListener('load', sync);
}

// fractional star display: fills to the exact proportion (4.9/5 → 98%, not a full row)
const pdpStars = (r) => {
  const pct = Math.max(0, Math.min(100, (r / 5) * 100));
  return `<span class="stars-wrap"><span class="stars-base">★★★★★</span>`
       + `<span class="stars-fill" style="width:${pct}%">★★★★★</span></span>`;
};

/* Announcement bar: a slim, dismissible top ribbon with rotating messages.
   Portable to Shopify — swap MESSAGES for section settings / a metafield. */

const DISMISS_KEY = 'notterra-announce';
const MESSAGES = [
  'Free shipping on every pillow',
  'Delivered in 7–14 days · tracked',
  '3-year warranty · 60-night trial',
  'First order? Get 10% off'
];
/* slot 0 of the rotation is dynamic: it nudges toward the $65 free-shipping
   threshold once there's a cart to nudge, and falls back to the static
   line otherwise — same $65 the cart drawer and value band already quote. */
function shippingMessage() {
  if (window.NotteraCart && typeof window.NotteraCart.getTotal === 'function') {
    const countEl = document.getElementById('cartCount');
    const hasItems = countEl && !countEl.hidden;
    const total = window.NotteraCart.getTotal();
    if (hasItems && total > 0 && total < 65) {
      return `Add $${(65 - total).toFixed(2)} more for free shipping`;
    }
  }
  return MESSAGES[0];
}
function initAnnounce() {
  if (localStorage.getItem(DISMISS_KEY) === '1') return;

  const bar = document.createElement('div');
  bar.className = 'announce';
  bar.innerHTML = `
    <div class="announce-track" id="announceTrack"><span>${shippingMessage()}</span></div>
    <button class="announce-close" id="announceClose" aria-label="Dismiss announcement">&times;</button>`;
  document.body.insertBefore(bar, document.body.firstChild);
  document.body.classList.add('has-announce');

  const track = bar.querySelector('#announceTrack span');
  let idx = 0;
  function show(i) {
    track.style.opacity = '0';
    setTimeout(() => { track.textContent = i === 0 ? shippingMessage() : MESSAGES[i]; track.style.opacity = '1'; }, 350);
  }
  const timer = setInterval(() => {
    idx = (idx + 1) % MESSAGES.length;
    show(idx);
  }, 4200);

  // if the shipping slot is on screen right now, refresh it the moment the cart changes
  const cartItemsEl = document.getElementById('cartItems');
  if (cartItemsEl) {
    new MutationObserver(() => { if (idx === 0) show(0); }).observe(cartItemsEl, { childList: true, subtree: true, characterData: true });
  }

  bar.querySelector('#announceClose').addEventListener('click', () => {
    clearInterval(timer);
    bar.classList.add('closing');
    document.body.classList.remove('has-announce');
    localStorage.setItem(DISMISS_KEY, '1');
    setTimeout(() => bar.remove(), 400);
  });
}

/* Cookie consent banner (GDPR / CCPA-friendly). Stores the choice and exposes
   it on window.NotteraConsent so analytics/marketing scripts can gate on it.
   Wire real tag-loading into applyConsent() when you connect GA / Meta / etc. */

const KEY = 'notterra-consent';
function initConsent() {
  const saved = localStorage.getItem(KEY);
  window.NotteraConsent = saved || 'unset';
  if (saved) {
    // Re-sync with Shopify on every visit, not just the one where the choice
    // was made — a returning visitor's saved choice still needs to reach
    // Shopify's consent API each time the page loads.
    applyConsent(saved);
    return;
  }

  const bar = document.createElement('div');
  bar.className = 'consent';
  bar.setAttribute('role', 'dialog');
  bar.setAttribute('aria-label', 'Cookie notice');
  bar.innerHTML = `
    <p class="consent-text">
      We use cookies to run the store, remember your cart and understand what helps people sleep better.
      See our <a href="#/cookies">Cookie Policy</a>.
    </p>
    <div class="consent-actions">
      <button class="consent-btn ghost" data-consent="declined" type="button">Decline</button>
      <button class="consent-btn solid" data-consent="accepted" type="button">Accept</button>
    </div>`;
  document.body.appendChild(bar);
  requestAnimationFrame(() => bar.classList.add('open'));

  bar.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-consent]');
    if (!btn) return;
    const choice = btn.dataset.consent;
    localStorage.setItem(KEY, choice);
    window.NotteraConsent = choice;
    applyConsent(choice);
    bar.classList.remove('open');
    setTimeout(() => bar.remove(), 400);
  });
}

function applyConsent(choice) {
  const accepted = choice === 'accepted';
  // Registers the choice with Shopify's real Customer Privacy API — this is
  // what actually gates Shopify's own tracking and stops Shopify's native
  // cookie banner from appearing on top of ours (it only shows when no
  // consent decision has been recorded yet).
  if (window.Shopify && window.Shopify.customerPrivacy && typeof window.Shopify.customerPrivacy.setTrackingConsent === 'function') {
    window.Shopify.customerPrivacy.setTrackingConsent({
      analytics: accepted,
      marketing: accepted,
      preferences: accepted,
      sale_of_data: accepted
    }, function () {});
  }
}


/* Header account dropdown. Portable to Shopify: the Sign In / Create Account
   items already point to hash routes that render maquette pages; when the
   theme is published, swap their href for /account/login and /account/register
   so Shopify's built-in customer accounts take over. */
function initUserMenu() {
  const wrap = document.getElementById('userMenu');
  const btn = document.getElementById('userToggle');
  const dropdown = document.getElementById('userDropdown');
  if (!wrap || !btn || !dropdown) return;

  function close() {
    dropdown.hidden = true;
    btn.setAttribute('aria-expanded', 'false');
    wrap.classList.remove('open');
  }
  function open() {
    dropdown.hidden = false;
    btn.setAttribute('aria-expanded', 'true');
    wrap.classList.add('open');
  }
  function toggle() {
    dropdown.hidden ? open() : close();
  }

  btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
  document.addEventListener('click', (e) => { if (!wrap.contains(e.target)) close(); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  // any dropdown link click closes it before the hashchange nav
  dropdown.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
}

/* Nottera account + rewards balance — demo persistence via localStorage.
   One browser = one account here; wire this to Shopify customer accounts +
   a loyalty app (e.g. Smile.io) for real cross-device accounts at launch. */

const ACCOUNT_KEY = 'notterra-account';

function load() {
  try {
    const raw = localStorage.getItem(ACCOUNT_KEY);
    return raw ? JSON.parse(raw) : null;
  } catch { return null; }
}
function save(acc) {
  try { localStorage.setItem(ACCOUNT_KEY, JSON.stringify(acc)); } catch {}
}

function initAccount() {
  const toast = document.getElementById('toast');
  let toastTimer = null;
  function showToast(message) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 3200);
  }

  function render() {
    const mount = document.getElementById('accountApp');
    if (!mount) return;
    const acc = load();

    if (!acc) {
      mount.innerHTML = `
        <form class="account-form" id="accountCreateForm">
          <input class="popup-input" type="email" name="email" placeholder="Your email" required>
          <input class="popup-input" type="password" name="password" placeholder="Create a password" required minlength="6">
          <button class="btn btn-primary popup-submit" type="submit">Create Account · +100 pts</button>
        </form>
        <p class="page-muted">Already have an account? <a href="#" id="accountSignInLink">Sign in</a>.</p>`;
      mount.querySelector('#accountCreateForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const email = e.target.email.value.trim();
        if (!email) return;
        const created = { email, points: 100, createdAt: Date.now() };
        save(created);
        showToast('Account created — +100 points');
        render();
      });
      mount.querySelector('#accountSignInLink').addEventListener('click', (e) => {
        e.preventDefault();
        showToast('No Nottera account found on this device yet — create one above');
      });
      return;
    }

    mount.innerHTML = `
      <div class="account-dash">
        <div class="account-dash-row">
          <div><span class="account-dash-label">Signed in as</span><span class="account-dash-value">${acc.email}</span></div>
          <div><span class="account-dash-label">Points balance</span><span class="account-dash-value gold">${acc.points}</span></div>
        </div>
        <p class="page-actions"><a class="btn btn-ghost" href="#/rewards">Redeem points</a><button class="btn btn-ghost" type="button" id="accountSignOut">Sign out</button></p>
      </div>`;

    mount.querySelector('#accountSignOut')?.addEventListener('click', () => {
      localStorage.removeItem(ACCOUNT_KEY);
      render();
    });
  }

  function renderRewardsBalance() {
    const mount = document.getElementById('rewardsBalance');
    if (!mount) return;
    const acc = load();
    if (!acc) { mount.innerHTML = ''; return; }
    mount.innerHTML = `
      <div class="account-dash rewards-balance">
        <div class="account-dash-row">
          <div><span class="account-dash-label">Signed in as</span><span class="account-dash-value">${acc.email}</span></div>
          <div><span class="account-dash-label">Points balance</span><span class="account-dash-value gold">${acc.points}</span></div>
        </div>
      </div>`;
  }

  /* My Orders — every order recorded against the signed-in account, newest
     first. In this demo, orders are recorded locally at checkout (see
     recordOrder below); on Shopify this would read the customer's real
     order history via the Customer Account API instead. */
  function renderOrders() {
    const mount = document.getElementById('ordersApp');
    if (!mount) return;
    const acc = load();
    if (!acc) {
      mount.innerHTML = `<div class="orders-empty">
        <p>Sign in to see your orders.</p>
        <a class="btn btn-primary" href="{{ routes.account_url }}">Sign in / Create account</a>
      </div>`;
      return;
    }
    const orders = acc.orders || [];
    if (!orders.length) {
      mount.innerHTML = `<div class="orders-empty"><p>No orders yet — your first one will show up here.</p></div>`;
      return;
    }
    mount.innerHTML = `<div class="orders-list">` + orders.map((o) => `
      <div class="order-card">
        <div class="order-card-head">
          <div><span class="order-card-id">Order #${o.id}</span><span class="order-card-date">${new Date(o.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span></div>
          <span class="order-card-total">${'$' + o.total.toFixed(2)}</span>
        </div>
        <ul class="order-card-items">
          ${o.items.map((it) => `<li>${it.qty} &times; ${it.variant && it.variant !== it.name ? it.variant : it.name}</li>`).join('')}
        </ul>
        <a class="order-card-track" href="{{ routes.account_url }}">Track this order &rarr;</a>
      </div>`).join('') + `</div>`;
  }

  var REAL_ACCOUNT_URL = '{{ routes.account_url }}';
  function goToRealAccount() { window.location.href = REAL_ACCOUNT_URL; }

  addEventListener('hashchange', () => {
    if (location.hash === '#/account') { goToRealAccount(); return; }
    if (location.hash === '#/rewards') renderRewardsBalance();
    if (location.hash === '#/orders') { goToRealAccount(); return; }
  });
  if (location.hash === '#/account') { goToRealAccount(); }
  if (location.hash === '#/rewards') renderRewardsBalance();
  if (location.hash === '#/orders') { goToRealAccount(); }

  /* Exposed so the cart can credit purchase points and record the order at checkout. */
  window.NotteraAccount = {
    creditPurchasePoints(amount) {
      const acc = load();
      if (!acc) return;
      acc.points += Math.round(amount * 2);
      save(acc);
    },
    recordOrder(itemsSnapshot, total) {
      const acc = load();
      if (!acc) return null;
      acc.orders = acc.orders || [];
      const id = 'NT' + Math.floor(10000 + Math.random() * 90000);
      acc.orders.unshift({ id, date: Date.now(), items: itemsSnapshot, total });
      save(acc);
      return id;
    },
    isSignedIn() { return !!load(); }
  };
}

/* "By the numbers" count-up. Each .stat-count animates from 0 to data-to when
   it scrolls into view (easeOutCubic). Honors prefers-reduced-motion. */
function initStats() {
  const nums = document.querySelectorAll('.stat-count');
  if (!nums.length) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (n, sep) => sep ? Math.round(n).toLocaleString('en-US') : String(Math.round(n));
  const run = (el) => {
    const to = parseFloat(el.dataset.to) || 0;
    const sep = el.dataset.sep === '1';
    if (reduce) { el.textContent = fmt(to, sep); return; }
    const dur = 1600, t0 = performance.now();
    const tick = (now) => {
      const p = Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(to * e, sep);
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const io = new IntersectionObserver((entries) => {
    entries.forEach((en) => { if (en.isIntersecting) { run(en.target); io.unobserve(en.target); } });
  }, { threshold: 0.6 });
  nums.forEach((el) => io.observe(el));
}

