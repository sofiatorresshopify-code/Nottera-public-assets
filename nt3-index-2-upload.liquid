<script>
(function(){
  var COLORS=[
    {k:'moonlight',name:'Moonlight',sw:'#E0D2C3',light:true},
    {k:'nebula',name:'Nebula',sw:'#62615F'},
    {k:'polaris',name:'Polaris',sw:'#2A3858'},
    {k:'aurora',name:'Aurora',sw:'#496C73'},
    {k:'venus',name:'Venus',sw:'#F3AEC4',light:true}
  ];
  var FABRICS=[
    {k:'ice',name:'Ice-Silk',cls:'ice',sub:'Cool, smooth, low-friction',sizes:{crescent:[28.99,36.99],eclipse:[32.99,41.99]},ids:{crescent:'casecrescent',eclipse:'caseeclipse'}}
  ];
  var SIZES=[{k:'crescent',name:'Crescent'},{k:'eclipse',name:'Eclipse'}];

  /* One card per colour, not per colour+size: both sizes look identical in a
     thumbnail, so listing them twice just doubled the grid. The size is chosen
     on the product page, which already has its own Crescent/Eclipse selector —
     so the card links there instead of adding a fixed size straight to cart. */
  var SIGNATURE=['polaris','moonlight']; // the two brand colours: navy + champagne
  function cards(){
    var h='';
    FABRICS.forEach(function(f){
      COLORS.forEach(function(c){
        // price runs "from" the smaller size, since one card now covers both
        var lo=f.sizes.crescent, now=lo[0], was=lo[1], save=Math.round((1-now/was)*100);
        var onSale=(c.k==='moonlight'||c.k==='polaris');
        var priceHTML='<span class="bed-from">From</span>'
          + '<span class="bed-now">$'+now.toFixed(2)+'</span>'
          + (onSale?'<span class="bed-was">$'+was.toFixed(2)+'</span><span class="bed-save">Save '+save+'%</span>':'');
        var hero=(window.NOTTERA_CASE_HERO||{})[c.k];
        var isSig=SIGNATURE.indexOf(c.k)>-1;
        h+='<article class="bed-card" data-fab="'+f.k+'" data-color="'+c.k+'">'
         +'<a class="bed-clink" href="#/pc'+f.k+c.k+'">'
         +'<div class="bed-thumb'+(c.light?' is-light':'')+'"'+(hero?'':' style="background:'+c.sw+'"')+'>'+(hero?'<img class="bed-thumb-img" src="'+hero+'" alt="'+c.name+' pillowcase" loading="lazy">':'')
           +'<span class="bed-thumb-tag">'+f.name+'</span>'
           +(isSig?'<span class="bed-thumb-sig">Nottera Signature</span>':'')
           +(isSig?'<span class="bed-thumb-limited">Limited time offer</span>':'')
         +'</div>'
         +'<div class="bed-cbody">'
         +'<h3 class="bed-cname">'+c.name+'</h3>'
         +'<p class="bed-cmeta">'+f.name+' pillowcase &middot; Crescent &amp; Eclipse</p>'
         +'<p class="bed-price">'+priceHTML+'</p>'
         +'<span class="btn btn-primary bed-choosesize">Choose size</span>'
         +'</div></a></article>';
      });
    });
    return h;
  }
  function checks(type,arr,dot){
    return arr.map(function(o){
      var d=dot?'<span class="bed-dot'+(o.light?' is-light':'')+'" style="background:'+o.sw+'"></span>':'';
      return '<label class="bed-check"><input type="checkbox" class="bed-filter" data-type="'+type+'" value="'+o.k+'">'+d+'<span>'+o.name+'</span></label>';
    }).join('');
  }
  function buildBed(root){
    root.innerHTML=
      '<p class="bed-lead">Pillowcases you can buy on their own — a cool, silky-smooth ice-silk case cut to fit every Nottera pillow. Begin with a colour.</p>'
      +'<button class="bed-ftoggle" type="button" id="bedFilterToggle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M8 12h8M11 18h2"/></svg><span>Filters</span></button>'
      +'<div class="bed-layout">'
      +'<aside class="bed-filters" id="bedFiltersPanel">'
      +'<button class="bed-fclose" type="button" id="bedFilterClose" aria-label="Close filters">&times;</button>'
      +'<div class="bed-fhead">Filters</div>'
      +'<div class="bed-fgroup"><span class="bed-flabel">Colour</span>'+checks('color',COLORS,true)+'</div>'
      /* No size filter: every colour comes in both sizes, so filtering by size
         would never narrow the grid. Size is picked on the product page. */
      +'<button class="bed-clear" type="button" data-bed-clear>Clear all</button>'
      +'<button class="btn btn-primary bed-fapply" type="button" id="bedFilterApply">Show results</button>'
      +'</aside>'
      +'<div class="bed-main"><p class="bed-count" id="bedCount"></p><div class="bed-grid" id="bedGrid">'+cards()+'</div></div>'
      +'</div>';
  }
  function checkedVals(type){
    return Array.prototype.slice.call(document.querySelectorAll('.bed-filter[data-type="'+type+'"]:checked')).map(function(x){return x.value;});
  }
  function bedApply(){
    var grid=document.getElementById('bedGrid'); if(!grid) return;
    var fabs=checkedVals('fab'),cols=checkedVals('color'),n=0;
    Array.prototype.forEach.call(grid.children,function(card){
      var show=(!fabs.length||fabs.indexOf(card.dataset.fab)>-1)&&(!cols.length||cols.indexOf(card.dataset.color)>-1);
      card.style.display=show?'':'none'; if(show)n++;
    });
    var cnt=document.getElementById('bedCount'); if(cnt)cnt.textContent=n+(n===1?' colour':' colours');
    var active=fabs.length===1?fabs[0]:null;
    Array.prototype.forEach.call(document.querySelectorAll('.bed-fabtile'),function(t){t.classList.toggle('is-active',t.dataset.fab===active);});
    var va=document.querySelector('.bed-viewall'); if(va)va.classList.toggle('show',!!(fabs.length||cols.length));
  }
  function setFabric(v){
    Array.prototype.forEach.call(document.querySelectorAll('.bed-filter[data-type="fab"]'),function(cb){cb.checked=(cb.value===v);});
    bedApply();
    var grid=document.getElementById('bedGrid'); if(grid)grid.scrollIntoView({behavior:'smooth',block:'start'});
  }
  document.addEventListener('change',function(e){
    if(e.target&&e.target.classList&&e.target.classList.contains('bed-filter')) bedApply();
  });
  document.addEventListener('click',function(e){
    if(!e.target||!e.target.closest) return;
    var tile=e.target.closest('.bed-fabtile');
    if(tile){var v=tile.dataset.fab;var cur=document.querySelector('.bed-filter[data-type="fab"][value="'+v+'"]');
      if(cur&&cur.checked){cur.checked=false;bedApply();}else{setFabric(v);} return;}
    var va=e.target.closest('[data-bed-viewall]');
    if(va){Array.prototype.forEach.call(document.querySelectorAll('.bed-filter'),function(cb){cb.checked=false;}); bedApply(); return;}
    var clr=e.target.closest('[data-bed-clear]');
    if(clr){Array.prototype.forEach.call(document.querySelectorAll('.bed-filter'),function(cb){cb.checked=false;}); bedApply(); return;}
    var add=e.target.closest('.bed-add');
    if(add&&window.NotteraCart){window.NotteraCart.add(add.dataset.add,add.dataset.variant||'',1);}
  });
  function ensureBed(){
    if(location.hash!=='#/bed') return;
    var r=document.getElementById('bedRoot');
    if(r&&!r.dataset.built){buildBed(r); r.dataset.built='1'; bedApply();}
  }
  addEventListener('hashchange',function(){setTimeout(ensureBed,0);});
  if(document.readyState==='complete'){setTimeout(ensureBed,0);}else{addEventListener('load',function(){setTimeout(ensureBed,0);});}
})();
</script>
