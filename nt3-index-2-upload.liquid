    var pvb=e.target.closest('.pil-info .voltier');
    if(pvb){
      Array.prototype.forEach.call(document.querySelectorAll('.pil-info .voltier'),function(b){b.classList.toggle('is-active',b===pvb);});
      var pqty=parseInt(pvb.getAttribute('data-vol'),10);
      var padd=document.getElementById('pilAdd'), pnow=document.getElementById('pilNow');
      if(padd&&pnow&&window.NotteraCart){
        var punit=parseFloat(pnow.textContent.replace(/[^0-9.]/g,''))||0;
        if(pqty<=1){
          window.NotteraCart.add(padd.dataset.add,padd.dataset.variant,1);
        }else{
          var ppct=pqty>=3?15:10;
          var pdisc=+(punit*(1-ppct/100)).toFixed(2);
          window.NotteraCart.add(padd.dataset.add,padd.dataset.variant,pqty,{price:pdisc,requires:null,minQty:pqty,keySuffix:'vol-'+padd.dataset.variant,note:'Volume · '+ppct+'% off'});
        }
        if(window.NotteraCart.open)window.NotteraCart.open();
      }
      return;
    }
  });
  function ensurePillow(){
    if(location.hash!=='#/pillow') return;
    var r=document.getElementById('pillowRoot');
    if(r&&!r.dataset.built){buildPillow(r); r.dataset.built='1';}
    if(window.__pendingPillowSize){
      var szBtn=document.querySelector('.pil-size[data-size="'+window.__pendingPillowSize+'"]');
      if(szBtn)szBtn.click();
      window.__pendingPillowSize=null;
    }
  }
  addEventListener('hashchange',function(){setTimeout(ensurePillow,0);});
  if(document.readyState==='complete'){setTimeout(ensurePillow,0);}else{addEventListener('load',function(){setTimeout(ensurePillow,0);});}
})();

/* ============ STICKY MINI-CART BAR (PDP) ============ */
(function(){
  var bar=null,io=null,target=null;
  function ensureBar(){
    if(bar) return bar;
    bar=document.createElement('div');
    bar.className='sticky-buybar';
    bar.id='stickyBuybar';
    bar.setAttribute('role','region');
    bar.setAttribute('aria-label','Quick add');
    bar.innerHTML='<div class="sb-id"><span class="sb-mark">N</span><div class="sb-text"><p class="sb-name" id="sbName"></p><p class="sb-price" id="sbPrice"></p></div></div><button class="btn btn-primary bed-add" type="button" id="sbAdd">Add to night</button>';
    document.body.appendChild(bar);
    return bar;
  }
  function sync(){
    var t=document.getElementById('pilAdd'); if(!t) return;
    ensureBar();
    var nameEl=document.getElementById('sbName'),priceEl=document.getElementById('sbPrice'),addEl=document.getElementById('sbAdd'),priceSrc=document.getElementById('pilNow');
    if(nameEl)nameEl.textContent='The Nottera Pillow';
    if(priceEl)priceEl.textContent=priceSrc?priceSrc.textContent:'';
    if(addEl){addEl.dataset.add=t.dataset.add;addEl.dataset.variant=t.dataset.variant;}
  }
  function watch(){
    var t=document.getElementById('pilAdd');
    if(!t){ if(bar)bar.classList.remove('show'); if(io&&target)io.unobserve(target); target=null; return; }
    if(t===target){ sync(); return; }
    if(io&&target)io.unobserve(target);
    target=t; ensureBar(); sync();
    if(!io){
      io=new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          var b=ensureBar();
          if(en.isIntersecting){ b.classList.remove('show'); }
          else if(en.boundingClientRect.top<0){ sync(); b.classList.add('show'); }
          else { b.classList.remove('show'); }
        });
      },{threshold:0});
    }
    io.observe(t);
  }
  document.addEventListener('click',function(e){
    if(!e.target||!e.target.closest) return;
    if(e.target.closest('.pil-size'))setTimeout(sync,30);
  });
  addEventListener('hashchange',function(){setTimeout(watch,80);});
  if(document.readyState==='complete'){setTimeout(watch,350);}else{addEventListener('load',function(){setTimeout(watch,350);});}
})();
</script>

